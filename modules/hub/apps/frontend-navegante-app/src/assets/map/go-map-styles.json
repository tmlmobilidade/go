{
	"glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
	"id": "lisbon-mapbox-like-vivid",
	"layers": [
		{
			"id": "background",
			"paint": {
				"background-color": "#f3f1eb"
			},
			"type": "background"
		},
		{
			"filter": ["match", ["get", "class"], ["residential", "neighbourhood", "suburb"], true, false],
			"id": "landuse-residential",
			"paint": {
				"fill-color": "#fbf8f2",
				"fill-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 14, 0.35]
			},
			"source": "openmaptiles",
			"source-layer": "landuse",
			"type": "fill"
		},
		{
			"filter": ["match", ["get", "class"], ["commercial", "industrial", "garages", "railway"], true, false],
			"id": "landuse-commercial-industrial",
			"paint": {
				"fill-color": "#efe4d3",
				"fill-opacity": 0.78
			},
			"source": "openmaptiles",
			"source-layer": "landuse",
			"type": "fill"
		},
		{
			"filter": ["match", ["get", "class"], ["school", "hospital", "cemetery"], true, false],
			"id": "landuse-civic",
			"paint": {
				"fill-color": "#f0ead2",
				"fill-opacity": 0.86
			},
			"source": "openmaptiles",
			"source-layer": "landuse",
			"type": "fill"
		},
		{
			"filter": ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
			"id": "park",
			"paint": {
				"fill-color": "#bdeeb5",
				"fill-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0.72, 14, 0.86]
			},
			"source": "openmaptiles",
			"source-layer": "park",
			"type": "fill"
		},
		{
			"filter": ["==", ["get", "class"], "wood"],
			"id": "landcover-wood",
			"paint": {
				"fill-color": "#b8eeb0",
				"fill-opacity": 0.72
			},
			"source": "openmaptiles",
			"source-layer": "landcover",
			"type": "fill"
		},
		{
			"filter": ["==", ["get", "class"], "grass"],
			"id": "landcover-grass",
			"paint": {
				"fill-color": "#cef1bf",
				"fill-opacity": 0.7
			},
			"source": "openmaptiles",
			"source-layer": "landcover",
			"type": "fill"
		},
		{
			"filter": ["==", ["get", "class"], "sand"],
			"id": "landcover-sand",
			"paint": {
				"fill-color": "#f5e7b8",
				"fill-opacity": 0.95
			},
			"source": "openmaptiles",
			"source-layer": "landcover",
			"type": "fill"
		},
		{
			"filter": ["!=", ["get", "brunnel"], "tunnel"],
			"id": "water",
			"paint": {
				"fill-color": "#8bd2e8"
			},
			"source": "openmaptiles",
			"source-layer": "water",
			"type": "fill"
		},
		{
			"id": "waterway",
			"layout": {
				"line-cap": "round",
				"line-join": "round"
			},
			"paint": {
				"line-color": "#55bddf",
				"line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 10, 0.8, 14, 1.7, 18, 6]
			},
			"source": "openmaptiles",
			"source-layer": "waterway",
			"type": "line"
		},
		{
			"id": "building",
			"minzoom": 14,
			"paint": {
				"fill-color": "#dedbd4",
				"fill-opacity": 0.72,
				"fill-outline-color": "#d2ccc3"
			},
			"source": "openmaptiles",
			"source-layer": "building",
			"type": "fill"
		},
		{
			"filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["minor", "service", "track"], true, false], ["!=", ["get", "brunnel"], "tunnel"]],
			"id": "road-minor-casing",
			"layout": {
				"line-cap": "round",
				"line-join": "round"
			},
			"paint": {
				"line-color": "#cbd2dc",
				"line-opacity": ["interpolate", ["linear"], ["zoom"], 11, 0, 13, 0.22, 16, 0.32],
				"line-width": ["interpolate", ["exponential", 1.25], ["zoom"], 12, 0.8, 14, 2.4, 18, 11]
			},
			"source": "openmaptiles",
			"source-layer": "transportation",
			"type": "line"
		},
		{
			"filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk"], true, false], ["!=", ["get", "brunnel"], "tunnel"]],
			"id": "road-major-casing",
			"layout": {
				"line-cap": "round",
				"line-join": "round"
			},
			"paint": {
				"line-color": "#b6bfcc",
				"line-opacity": 0.32,
				"line-width": ["interpolate", ["exponential", 1.25], ["zoom"], 7, 0.9, 10, 1.6, 14, 4.8, 18, 17]
			},
			"source": "openmaptiles",
			"source-layer": "transportation",
			"type": "line"
		},
		{
			"filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["==", ["get", "class"], "motorway"], ["!=", ["get", "brunnel"], "tunnel"]],
			"id": "road-motorway-casing",
			"layout": {
				"line-cap": "round",
				"line-join": "round"
			},
			"paint": {
				"line-color": "#aab4c4",
				"line-opacity": 0.38,
				"line-width": ["interpolate", ["exponential", 1.25], ["zoom"], 5, 1.1, 8, 2.4, 12, 5.2, 18, 21]
			},
			"source": "openmaptiles",
			"source-layer": "transportation",
			"type": "line"
		},
		{
			"filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["minor", "service", "track"], true, false], ["!=", ["get", "brunnel"], "tunnel"]],
			"id": "road-minor",
			"layout": {
				"line-cap": "round",
				"line-join": "round"
			},
			"paint": {
				"line-color": "#e1e6ee",
				"line-opacity": ["interpolate", ["linear"], ["zoom"], 11, 0.02, 13, 0.55, 16, 0.68],
				"line-width": ["interpolate", ["exponential", 1.25], ["zoom"], 12, 0.35, 14, 1.45, 18, 8]
			},
			"source": "openmaptiles",
			"source-layer": "transportation",
			"type": "line"
		},
		{
			"filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk"], true, false], ["!=", ["get", "brunnel"], "tunnel"]],
			"id": "road-major",
			"layout": {
				"line-cap": "round",
				"line-join": "round"
			},
			"paint": {
				"line-color": "#d1d8e4",
				"line-opacity": 0.68,
				"line-width": ["interpolate", ["exponential", 1.25], ["zoom"], 7, 0.35, 10, 0.9, 14, 3.2, 18, 12]
			},
			"source": "openmaptiles",
			"source-layer": "transportation",
			"type": "line"
		},
		{
			"filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["==", ["get", "class"], "motorway"], ["!=", ["get", "brunnel"], "tunnel"]],
			"id": "road-motorway",
			"layout": {
				"line-cap": "round",
				"line-join": "round"
			},
			"paint": {
				"line-color": "#bec7d6",
				"line-opacity": 0.72,
				"line-width": ["interpolate", ["exponential", 1.25], ["zoom"], 5, 0.55, 8, 1.4, 12, 3.4, 18, 15]
			},
			"source": "openmaptiles",
			"source-layer": "transportation",
			"type": "line"
		},
		{
			"filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["rail", "transit"], true, false]],
			"id": "rail",
			"layout": {
				"line-cap": "round",
				"line-join": "round"
			},
			"paint": {
				"line-color": "#7f8894",
				"line-opacity": 0.9,
				"line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.8, 13, 1.8, 16, 3.2, 18, 5]
			},
			"source": "openmaptiles",
			"source-layer": "transportation",
			"type": "line"
		},
		{
			"filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["rail", "transit"], true, false]],
			"id": "rail-dash",
			"layout": {
				"line-cap": "round",
				"line-join": "round"
			},
			"paint": {
				"line-color": "#ffffff",
				"line-dasharray": [0.25, 5],
				"line-opacity": 0.85,
				"line-width": ["interpolate", ["linear"], ["zoom"], 13, 0, 15, 1.6, 18, 3.2]
			},
			"source": "openmaptiles",
			"source-layer": "transportation",
			"type": "line"
		},
		{
			"filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["ferry"], true, false]],
			"id": "ferry-route",
			"layout": {
				"line-cap": "round",
				"line-join": "round"
			},
			"paint": {
				"line-color": "#7f8894",
				"line-dasharray": [1.2, 1.2],
				"line-opacity": ["interpolate", ["linear"], ["zoom"], 9, 0.55, 13, 0.9],
				"line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.9, 13, 2.2, 17, 4]
			},
			"source": "openmaptiles",
			"source-layer": "transportation",
			"type": "line"
		},
		{
			"filter": ["!=", ["get", "maritime"], 1],
			"id": "boundary",
			"layout": {
				"visibility": "none"
			},
			"paint": {
				"line-color": "#e783ac",
				"line-dasharray": [2, 2],
				"line-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.22, 10, 0.56],
				"line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.55, 10, 1.05]
			},
			"source": "openmaptiles",
			"source-layer": "boundary",
			"type": "line"
		},
		{
			"id": "water-label",
			"layout": {
				"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
				"text-font": ["Noto Sans Italic"],
				"text-letter-spacing": 0.1,
				"text-max-width": 8,
				"text-size": ["interpolate", ["linear"], ["zoom"], 5, 10, 11, 15]
			},
			"paint": {
				"text-color": "#108bd0",
				"text-halo-color": "rgba(255,255,255,0.72)",
				"text-halo-width": 1
			},
			"source": "openmaptiles",
			"source-layer": "water_name",
			"type": "symbol"
		},
		{
			"filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk", "motorway"], true, false],
			"id": "road-label-major",
			"layout": {
				"symbol-placement": "line",
				"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
				"text-font": ["Noto Sans Regular"],
				"text-size": ["interpolate", ["linear"], ["zoom"], 12, 9, 16, 12]
			},
			"minzoom": 13,
			"paint": {
				"text-color": "#7c8493",
				"text-halo-color": "#ffffff",
				"text-halo-width": 0.75
			},
			"source": "openmaptiles",
			"source-layer": "transportation_name",
			"type": "symbol"
		},
		{
			"filter": ["all", ["has", "ref"], ["<=", ["get", "ref_length"], 6], ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false]],
			"id": "road-shield",
			"layout": {
				"icon-image": ["concat", "road_", ["to-string", ["get", "ref_length"]]],
				"icon-rotate": 0,
				"icon-rotation-alignment": "viewport",
				"icon-size": 1,
				"symbol-placement": "point",
				"symbol-spacing": 260,
				"text-field": ["to-string", ["get", "ref"]],
				"text-font": ["Noto Sans Bold"],
				"text-rotate": 0,
				"text-rotation-alignment": "viewport",
				"text-size": 9
			},
			"minzoom": 12,
			"paint": {
				"text-color": "#005ADC"
			},
			"source": "openmaptiles",
			"source-layer": "transportation_name",
			"type": "symbol"
		},
		{
			"filter": ["match", ["get", "class"], ["rail", "airport", "ferry", "harbor", "subway"], true, false],
			"id": "poi-transit-station",
			"layout": {
				"icon-image": ["to-string", ["get", "class"]],
				"icon-size": ["interpolate", ["linear"], ["zoom"], 10, 0.72, 14, 0.9, 16, 1],
				"text-anchor": "top",
				"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
				"text-font": ["Noto Sans Bold"],
				"text-max-width": 9,
				"text-offset": [0, 0.85],
				"text-size": ["interpolate", ["linear"], ["zoom"], 10, 9, 14, 10.5, 16, 12]
			},
			"minzoom": 10,
			"paint": {
				"text-color": "#005ADC",
				"text-halo-color": "#ffffff",
				"text-halo-width": 1.1
			},
			"source": "openmaptiles",
			"source-layer": "poi",
			"type": "symbol"
		},
		{
			"filter": ["==", ["get", "class"], "bus"],
			"id": "poi-transit-bus",
			"layout": {
				"icon-image": "bus",
				"icon-size": ["interpolate", ["linear"], ["zoom"], 13, 0.62, 16, 0.78],
				"text-anchor": "top",
				"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
				"text-font": ["Noto Sans Regular"],
				"text-max-width": 8,
				"text-offset": [0, 0.75],
				"text-size": ["interpolate", ["linear"], ["zoom"], 13, 8, 16, 9.5]
			},
			"minzoom": 13,
			"paint": {
				"text-color": "#005ADC",
				"text-halo-color": "#ffffff",
				"text-halo-width": 0.8
			},
			"source": "openmaptiles",
			"source-layer": "poi",
			"type": "symbol"
		},
		{
			"filter": ["match", ["get", "class"], ["park", "garden"], true, false],
			"id": "poi-park",
			"layout": {
				"icon-image": "park",
				"icon-size": 0.8,
				"text-anchor": "top",
				"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
				"text-font": ["Noto Sans Regular"],
				"text-max-width": 9,
				"text-offset": [0, 0.75],
				"text-size": 10
			},
			"minzoom": 14,
			"paint": {
				"text-color": "#238734",
				"text-halo-color": "#ffffff",
				"text-halo-width": 0.85
			},
			"source": "openmaptiles",
			"source-layer": "poi",
			"type": "symbol"
		},
		{
			"filter": ["match", ["get", "class"], ["hamlet", "neighbourhood", "suburb", "quarter", "island"], true, false],
			"id": "place-other",
			"layout": {
				"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
				"text-font": ["Noto Sans Regular"],
				"text-max-width": 8,
				"text-size": ["interpolate", ["linear"], ["zoom"], 10, 8, 15, 11]
			},
			"minzoom": 9,
			"paint": {
				"text-color": "#273241",
				"text-halo-color": "#ffffff",
				"text-halo-width": 0.9
			},
			"source": "openmaptiles",
			"source-layer": "place",
			"type": "symbol"
		},
		{
			"filter": ["==", ["get", "class"], "village"],
			"id": "place-village",
			"layout": {
				"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
				"text-font": ["Noto Sans Regular"],
				"text-max-width": 9,
				"text-size": ["interpolate", ["linear"], ["zoom"], 8, 8.5, 12, 11.5]
			},
			"minzoom": 8,
			"paint": {
				"text-color": "#202833",
				"text-halo-color": "#ffffff",
				"text-halo-width": 0.9
			},
			"source": "openmaptiles",
			"source-layer": "place",
			"type": "symbol"
		},
		{
			"filter": ["==", ["get", "class"], "town"],
			"id": "place-town",
			"layout": {
				"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
				"text-font": ["Noto Sans Regular"],
				"text-max-width": 9,
				"text-size": ["interpolate", ["linear"], ["zoom"], 6, 9, 10, 12.5, 13, 15]
			},
			"minzoom": 6,
			"paint": {
				"text-color": "#11151b",
				"text-halo-color": "#ffffff",
				"text-halo-width": 1
			},
			"source": "openmaptiles",
			"source-layer": "place",
			"type": "symbol"
		},
		{
			"filter": ["all", ["==", ["get", "class"], "city"], ["has", "capital"], [">", ["get", "capital"], 0]],
			"id": "place-capital",
			"layout": {
				"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
				"text-font": ["Noto Sans Regular"],
				"text-max-width": 9,
				"text-size": ["interpolate", ["linear"], ["zoom"], 5, 12, 8, 16, 11, 21]
			},
			"minzoom": 4,
			"paint": {
				"text-color": "#0f141b",
				"text-halo-color": "#ffffff",
				"text-halo-width": 1.25
			},
			"source": "openmaptiles",
			"source-layer": "place",
			"type": "symbol"
		},
		{
			"filter": ["all", ["==", ["get", "class"], "city"], ["any", ["!", ["has", "capital"]], ["==", ["get", "capital"], 0]]],
			"id": "place-city",
			"layout": {
				"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
				"text-font": ["Noto Sans Regular"],
				"text-max-width": 9,
				"text-size": ["interpolate", ["linear"], ["zoom"], 5, 10, 8, 13, 11, 16]
			},
			"minzoom": 4,
			"paint": {
				"text-color": "#0f141b",
				"text-halo-color": "#ffffff",
				"text-halo-width": 1.15
			},
			"source": "openmaptiles",
			"source-layer": "place",
			"type": "symbol"
		}
	],
	"metadata": {
		"description": "MapLibre/OpenMapTiles style tuned toward the vivid Mapbox Streets look: cyan water, saturated parks, blue-grey roads, clear city labels.",
		"renderer": "maplibre",
		"source": "OpenFreeMap / OpenMapTiles schema"
	},
	"name": "Lisbon Mapbox-Like Vivid",
	"sources": {
		"openmaptiles": {
			"type": "vector",
			"url": "https://tiles.openfreemap.org/planet"
		}
	},
	"sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
	"version": 8
}
