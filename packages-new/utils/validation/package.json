{
	"name": "@tmlmobilidade/go-utils-validation",
	"version": "1.0.0",
	"author": {
		"email": "iso@tmlmobilidade.pt",
		"name": "TML-ISO"
	},
	"license": "AGPL-3.0-or-later",
	"homepage": "https://go.tmlmobilidade.pt",
	"bugs": {
		"url": "https://github.com/tmlmobilidade/go/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tmlmobilidade/go.git"
	},
	"keywords": [
		"public transit",
		"tml",
		"transportes metropolitanos de lisboa",
		"go"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist",
		"THIRD_PARTY_NOTICES.md"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./locales/*": "./dist/locales/*.json"
	},
	"scripts": {
		"build": "npm run check:translations && tsc && resolve-tspaths",
		"check:translations": "node --import tsx --test tests/catalogs.test.ts",
		"lint": "eslint ./src ./tests && tsc -p tsconfig.check.json --noEmit",
		"lint:fix": "eslint ./src/ --fix",
		"test": "node --import tsx --test tests/*.test.ts",
		"watch": "tsc-watch --onSuccess 'resolve-tspaths'"
	},
	"dependencies": {
		"i18next": "26.5.10",
		"i18next-icu": "2.6.1",
		"zod": "4.6.7",
		"zod-i18n-map": "3.0.1"
	},
	"devDependencies": {
		"@tmlmobilidade/go-utils-tsconfig": "*",
		"@types/node": "26.6.5",
		"intl-messageformat": "12.1.4",
		"resolve-tspaths": "0.8.23",
		"tsc-watch": "7.2.1",
		"tsx": "4.23.15",
		"typescript": "6.0.3"
	}
}
