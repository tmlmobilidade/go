	},
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"files": ["dist"],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc && resolve-tspaths",
		"dev": "tsx watch src/index.ts",
		"lint": "eslint ./src ./tests && tsc -p tsconfig.check.json --noEmit",
		"lint:fix": "eslint ./src ./tests --fix",
		"start": "node dist/index.js",
		"test": "node --experimental-test-module-mocks --import tsx --test tests/*.test.ts"
	},
	"dependencies": {
		"@fastify/multipart": "10.1.6",
		"@tmlmobilidade/consts": "*",
		"@tmlmobilidade/go-clients-fastify": "*",
		"@tmlmobilidade/go-core-pckg-types": "*",
		"@tmlmobilidade/go-interfaces-godb": "*",
		"@tmlmobilidade/go-providers-auth": "*",
		"@tmlmobilidade/go-providers-emails": "*",
		"@tmlmobilidade/go-providers-locations": "*",
		"@tmlmobilidade/go-providers-storage": "*",
		"@tmlmobilidade/go-types-core": "*",
		"@tmlmobilidade/go-types-extractions": "*",
		"@tmlmobilidade/go-types-locations": "*",
		"@tmlmobilidade/go-types-permissions": "*",
		"@tmlmobilidade/go-types-shared": "*",
		"@tmlmobilidade/go-utils-dates": "*",
		"@tmlmobilidade/go-utils-telemetry": "*",
		"@tmlmobilidade/strings": "*"
	},
	"devDependencies": {
		"@tmlmobilidade/go-utils-tsconfig": "*",
		"@types/node": "26.6.5",
		"resolve-tspaths": "0.8.23",
		"tsx": "4.23.15",
		"typescript": "6.0.3"
	}
}
