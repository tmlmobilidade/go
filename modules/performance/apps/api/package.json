{
	"name": "@tmlmobilidade/go-performance-api",
	"version": "1.0.0",
	"author": {
		"email": "iso@tmlmobilidade.pt",
		"name": "TML-ISO"
	},
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"files": ["dist"],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc && resolve-tspaths",
		"dev": "tsx watch src/index.ts",
		"lint": "eslint ./src && tsc --noEmit",
		"lint:fix": "eslint --fix .",
		"test:demand-by-agency": "node --import tsx ./src/endpoints/metrics/tests/get-demand-by-agency.ts",
		"test:demand-metrics": "node --import tsx --test ./src/endpoints/metrics/tests/*.ts ./src/endpoints/passenger-demand/tests/*.ts",
		"test:network": "node --import tsx --test ./src/endpoints/network/tests/*.ts",
		"test:ride-performance": "node --import tsx --test ./src/endpoints/ride-performance/tests/*.ts"
	},
	"dependencies": {
		"@tmlmobilidade/consts": "*",
		"@tmlmobilidade/fastify": "*",
		"@tmlmobilidade/go-interfaces-godb": "*",
		"@tmlmobilidade/go-performance-pckg-scripts": "*",
		"@tmlmobilidade/go-types-performance": "*",
		"@tmlmobilidade/go-types-shared": "*",
		"@tmlmobilidade/interfaces": "*",
		"@tmlmobilidade/logger": "*",
		"@tmlmobilidade/utils": "*"
	},
	"devDependencies": {
		"@carrismetropolitana/api-types": "20260730.2028.44",
		"@tmlmobilidade/tsconfig": "*",
		"@tmlmobilidade/types": "*",
		"@types/node": "26.1.2",
		"resolve-tspaths": "0.8.23",
		"tsx": "4.23.4",
		"typescript": "6.0.3"
	}
}
